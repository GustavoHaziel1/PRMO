<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MorfoSintaxe</title>

  <link rel="stylesheet" href="css/styles.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#457a39">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
</head>
<body>

  <div class="formulario">
    <form id="form-emoji" action="/add" method="POST">

      <label for="emoji">Emoji:</label>
      <input type="text" name="emoji" id="emoji" autocomplete="off" required>

      <label for="significado">Significado:</label>
      <input type="text" name="significado" id="significado" autocomplete="off" required>

      <button type="submit" id="btn-salvar">Adicionar</button>
      <button type="button" id="btn-cancelar" hidden>Cancelar edição</button>

    </form>
  </div>

  <div class="lista">
    <table>
      <thead>
        <tr>
          <th>Emoji:</th>
          <th>Significado:</th>
          <th>Ações:</th>
        </tr>
      </thead>
      <tbody id="tabela-corpo">
        <% if (termos.length === 0) { %>
          <tr class="vazio">
            <td colspan="3">Nenhum termo cadastrado ainda.</td>
          </tr>
        <% } %>

        <% termos.forEach(termo => { %>
          <tr>
            <td data-label="Emoji"><%= termo.tipo %></td>
            <td data-label="Significado"><%= termo.significado %></td>
            <td data-label="Ações" class="acoes">
              <a class="btn-editar" href="/edit/<%= termo.id %>">Editar</a>
              <form action="/delete/<%= termo.id %>" method="POST">
                <button type="submit" class="btn-excluir">Deletar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (totalPaginas > 1) {
         const inicio = Math.max(1, paginaAtual - 2);
         const fim = Math.min(totalPaginas, paginaAtual + 2);
    %>
      <nav class="paginacao" aria-label="Paginação">

        <% if (paginaAtual > 1) { %>
          <a href="/?pagina=<%= paginaAtual - 1 %>" rel="prev" aria-label="Página anterior">&laquo;</a>
        <% } else { %>
          <span class="desativado" aria-hidden="true">&laquo;</span>
        <% } %>

        <% if (inicio > 1) { %>
          <a href="/?pagina=1">1</a>
          <% if (inicio > 2) { %><span class="reticencias">…</span><% } %>
        <% } %>

        <% for (let i = inicio; i <= fim; i++) { %>
          <% if (i === paginaAtual) { %>
            <span class="ativo" aria-current="page"><%= i %></span>
          <% } else { %>
            <a href="/?pagina=<%= i %>"><%= i %></a>
          <% } %>
        <% } %>

        <% if (fim < totalPaginas) { %>
          <% if (fim < totalPaginas - 1) { %><span class="reticencias">…</span><% } %>
          <a href="/?pagina=<%= totalPaginas %>"><%= totalPaginas %></a>
        <% } %>

        <% if (paginaAtual < totalPaginas) { %>
          <a href="/?pagina=<%= paginaAtual + 1 %>" rel="next" aria-label="Próxima página">&raquo;</a>
        <% } else { %>
          <span class="desativado" aria-hidden="true">&raquo;</span>
        <% } %>

      </nav>
    <% } %>
  </div>

  <button id="btn-instalar" hidden>Instalar app</button>

  <script src="js/app.js"></script>
</body>
</html>